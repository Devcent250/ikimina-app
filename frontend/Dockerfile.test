# Minimal test Dockerfile
FROM nginx:alpine

# Create a simple test page
RUN echo '<html><body><h1>Frontend Test</h1><p>Working!</p></body></html>' > /usr/share/nginx/html/index.html

# Create health endpoint  
RUN echo 'OK' > /usr/share/nginx/html/health

# Simple nginx config for port 3000
RUN echo 'server { \
    listen 3000; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]